# Copy this file to .env locally, or install a protected EnvironmentFile on Linux.
# Uvicorn loads it only when --env-file is provided. Never commit the actual .env.
# Required: your own HTTPS URL including the service path, e.g. https://recorder.example.com/recorder
RECORDER_BASE_URL=
RECORDER_DATA_DIR=./data
# Required: the sole Google account and YouTube channel allowed in your deployment.
OWNER_EMAIL=
OWNER_CHANNEL_ID=
RECORDER_WORKER_ENABLED=false

# Current service capacity: 5 GiB per source video; 2 GiB free-space reserve.
MAX_UPLOAD_BYTES=5368709120
MIN_FREE_BYTES=2147483648
# Enable only after confirming the intended visibility and YouTube API eligibility.
ALLOW_PUBLIC_PUBLISH=false

# Use a Google OAuth Web application, with a protected credential file outside Git.
# Callback: <your RECORDER_BASE_URL>/api/oauth/callback
GOOGLE_CLIENT_SECRET_FILE=
# Alternatively, set GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET in the environment.

# Direct access by default. Explicit Google proxy, if your deployment needs one.
PROXY_MANAGED=0
GOOGLE_HTTP_PROXY=
PROXY_URL=
# Optional Linux managed proxy: configure your own unit and lock when enabled.
PROXY_SERVICE_NAME=
PROXY_LOCK_FILE=/run/lock/recorder-proxy.lock
# Optional comma-separated API hostnames that should bypass the configured proxy.
DIRECT_API_HOSTS=

# Install FFmpeg/ffprobe and provision the ASR model before enabling the worker.
DAIGUI_WHISPER_MODEL=base
DAIGUI_ALLOW_MODEL_DOWNLOAD=0
DAIGUI_ASR_LANGUAGE=zh
DAIGUI_FFMPEG_THREADS=1

# Blank metadata fields are generated using an authenticated backend provider.
DAIGUI_TEXT_PROVIDER=
DAIGUI_TEXT_BASE_URL=
DAIGUI_TEXT_MODEL=
DAIGUI_TEXT_API_KEY=
