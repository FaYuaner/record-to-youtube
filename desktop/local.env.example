# Optional local settings. Copy to local.env; keep credentials outside the repository.
# Recording works without Google credentials. YouTube connection needs a Desktop app OAuth JSON.
GOOGLE_CLIENT_SECRET_FILE=
# Optional explicit proxy for Google APIs, if required by your own network.
GOOGLE_HTTP_PROXY=
RECORDER_PROCESSING_MODE=direct
RECORDER_PROCESSOR_CONFIG=
ALLOW_PUBLIC_PUBLISH=false
# Leave identity empty to bind the first authorized account and its single selected channel.
OWNER_EMAIL=
OWNER_CHANNEL_ID=
RECORDER_LOCAL_PORT=18487
